{
  "name": "dashboard-archive",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first visual archive for dashboards and websites on macOS.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package:mac": "npm run build && electron-builder --mac dir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "fast-glob": "3.3.3",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.8.4",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-electron": "1.1.0",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.saul.dashboardarchive",
    "productName": "Dashboard Archive",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
